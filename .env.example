# =====================================================================
# Autonomous Dynamic Pricing Engine Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and fill in your API keys & service URLs.

# ---------------------------------------------------------------------
# 1. External API Keys (LLM Sentiment & Live Web Search)
# ---------------------------------------------------------------------
# GROQ_API_KEY: Powering AI Sentiment & Demand Trend Reasoning Agent
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# SERPER_API_KEY: Powering Live Google Shopping Web Price Scraper (Amazon.in, Flipkart, Croma, etc.)
# Obtain your API key at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ---------------------------------------------------------------------
# 2. Database & Infrastructure Services
# ---------------------------------------------------------------------
# DATABASE_URL: MySQL database connection string
# For Docker Compose environment: mysql+pymysql://pricing_user:pricing_password@mysql:3306/pricing_db
# For Local Host standalone dev:  mysql+pymysql://pricing_user:pricing_password@localhost:3307/pricing_db
DATABASE_URL=mysql+pymysql://pricing_user:pricing_password@mysql:3306/pricing_db

# REDIS_URL: Redis pub/sub broker for real-time WebSocket card streaming & Celery tasks
# For Docker Compose: redis://redis:6379/0
# For Local Host:     redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# CHROMA_URL: Vector Database URL for semantic product matching & catalog embeddings
# For Docker Compose: http://chroma:8000
# For Local Host:     http://localhost:8001
CHROMA_URL=http://chroma:8000

# ---------------------------------------------------------------------
# 3. Next.js Frontend Configuration
# ---------------------------------------------------------------------
# NEXT_PUBLIC_WS_URL: WebSocket endpoint for live Generative UI streaming cards
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/pricing-feed

# NEXT_PUBLIC_API_URL: Backend FastAPI HTTP base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------
# 4. Firebase Authentication Configuration (Google OAuth & Email/Password)
# ---------------------------------------------------------------------
# Create a free project at https://console.firebase.google.com -> Project Settings -> General -> Web App

# NEXT_PUBLIC_FIREBASE_API_KEY: Web API Key from Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: Firebase Auth Domain (e.g., your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here

# NEXT_PUBLIC_FIREBASE_PROJECT_ID: Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here

# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET: Firebase Storage Bucket (e.g., your-project-id.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here

# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID: Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here

# NEXT_PUBLIC_FIREBASE_APP_ID: Firebase Web App ID (e.g., 1:123456789:web:abcdef)
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID: Firebase Analytics Measurement ID (optional)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here
